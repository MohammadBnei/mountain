{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "world.json",
 "title": "world frame (R7 town): {t:'world', kind, ...payload}: plot (relay plots.go) | mark (visitor marks, validators.go).",
 "type": "object",
 "required": [
  "t",
  "kind"
 ],
 "oneOf": [
  {
   "properties": {
    "t": {
     "const": "world"
    },
    "kind": {
     "const": "mark"
    },
    "id": {
     "type": "string"
    },
    "mark": {
     "type": "string",
     "pattern": "^[a-z-]{1,24}$"
    },
    "pose": {
     "$ref": "hello.json#/$defs/pose"
    },
    "weight": {
     "type": "number"
    },
    "by": {
     "description": "the opt-in moderated handle (relay handle()); absent = a visitor",
     "type": "string",
     "pattern": "^[a-z0-9_-]{3,20}$"
    },
    "gone": {
     "description": "removed (admin mark.delete); pose is then {} and weight 0",
     "const": true
    }
   },
   "required": [
    "t",
    "kind",
    "id",
    "mark",
    "pose",
    "weight"
   ],
   "additionalProperties": false
  },
  {
   "properties": {
    "t": {
     "const": "world"
    },
    "kind": {
     "const": "plot"
    },
    "app": {
     "$ref": "#/$defs/app"
    },
    "host": {
     "$ref": "#/$defs/host"
    },
    "q": {
     "$ref": "#/$defs/hexc"
    },
    "r": {
     "$ref": "#/$defs/hexc"
    },
    "role": {
     "$ref": "#/$defs/role"
    },
    "ruinAt": {
     "type": "integer",
     "minimum": 0
    },
    "gone": {
     "type": "boolean"
    }
   },
   "required": [
    "t",
    "kind",
    "app",
    "host",
    "q",
    "r",
    "role"
   ],
   "additionalProperties": false
  }
 ],
 "$defs": {
  "app": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
  },
  "host": {
   "enum": [
    "h1",
    "h2",
    "h3"
   ]
  },
  "fp": {
   "type": "string",
   "pattern": "^[0-9a-f]{16}$"
  },
  "sev": {
   "enum": [
    "info",
    "warning",
    "critical"
   ]
  },
  "layer": {
   "enum": [
    "bedrock",
    "k8s",
    "apps"
   ]
  },
  "day": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "handle": {
   "description": "a moderated handle or 'a visitor'",
   "type": "string",
   "pattern": "^([a-z0-9_-]{3,20}|a visitor)$"
  },
  "hexc": {
   "type": "integer",
   "minimum": -7,
   "maximum": 7
  },
  "role": {
   "description": "R8: town building kind (relay/town Kinds; its family decides where it stands)",
   "enum": ["alehouse", "archive", "bookshop", "castle", "cellar", "church", "craneyard", "depot", "forge", "gate", "granary", "guardhouse", "hall", "home", "house", "inn", "keep", "market", "mill", "playhouse", "tavern", "tower", "vault", "warehouse", "watchtower", "witness"]
  },
  "plot": {
   "description": "R7 town plot: an app's building on the island of the host its pods run on (relay plots.go). ruinAt: app.gone time (unix ms), the building is ruins.",
   "type": "object",
   "required": [
    "app",
    "host",
    "q",
    "r",
    "role"
   ],
   "additionalProperties": false,
   "properties": {
    "app": {
     "$ref": "#/$defs/app"
    },
    "host": {
     "$ref": "#/$defs/host"
    },
    "q": {
     "$ref": "#/$defs/hexc"
    },
    "r": {
     "$ref": "#/$defs/hexc"
    },
    "role": {
     "$ref": "#/$defs/role"
    },
    "ruinAt": {
     "type": "integer",
     "minimum": 0
    }
   }
  }
 }
}
