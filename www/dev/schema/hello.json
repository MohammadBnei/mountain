{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hello.json",
  "title": "hello frame (server -> client, on connect and on resync)",
  "description": "int16 grids: base64 of little-endian int16, row-major (z outer, x inner), cell 0 at world (-100, -100), cell size 200/grid; one step = units.json HEIGHT_Q world units (0.01). bench: base64 of u8 (0..255), same layout. Generated by `relay dump-hello`, never by hand.",
  "type": "object",
  "required": ["t", "snapshot", "deltas", "state", "metrics"],
  "additionalProperties": false,
  "properties": {
    "t": { "const": "hello" },
    "snapshot": {
      "type": "object",
      "required": ["day", "seed", "grid", "base", "land", "bench", "caves"],
      "additionalProperties": false,
      "properties": {
        "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "seed": { "type": "integer", "minimum": 0 },
        "grid": { "const": 128 },
        "base": { "$ref": "#/$defs/grid16" },
        "land": { "$ref": "#/$defs/grid16" },
        "bench": { "type": "string", "pattern": "^[A-Za-z0-9+/]+=*$", "minLength": 21848, "maxLength": 21848 },
        "caves": {
          "type": "array", "minItems": 3, "maxItems": 5,
          "items": {
            "type": "object", "required": ["x", "z", "y", "yaw", "seed"], "additionalProperties": false,
            "properties": {
              "x": { "type": "number", "minimum": -100, "maximum": 100 },
              "z": { "type": "number", "minimum": -100, "maximum": 100 },
              "y": { "type": "number" },
              "yaw": { "type": "number" },
              "seed": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "deltas": { "type": "array", "items": { "type": "object", "required": ["t"], "properties": { "t": { "enum": ["ev", "world"] } } } },
    "state": {
      "description": "Live state a reload must not lose, persisted with the snapshot (W1b: firing alerts; W3b: veins, glacier, ash lines, health, replicas, builds in flight; W4: visitor marks, toy clouds). It changes only through frames (relay State.apply, mirrored by world.js).",
      "type": "object", "required": ["alerts", "veins", "glacier", "ash", "health", "replicas", "builds", "marks", "clouds"], "additionalProperties": false,
      "properties": {
        "alerts": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "required": ["fp", "sev", "layer", "startsAt"], "additionalProperties": false,
            "properties": {
              "fp": { "$ref": "ev.json#/$defs/fp" },
              "sev": { "$ref": "ev.json#/$defs/sev" },
              "layer": { "$ref": "ev.json#/$defs/layer" },
              "startsAt": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "veins": {
          "description": "world:vein payloads, oldest first, one per fp (a re-fire keeps the seam, the thicker radius wins).",
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "required": ["fp", "a", "b", "thick", "layer", "ref"], "additionalProperties": false,
            "properties": {
              "fp": { "$ref": "world.json#/$defs/fp" },
              "a": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "b": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "thick": { "type": "number" },
              "layer": { "$ref": "world.json#/$defs/layer" },
              "ref": { "type": "boolean" }
            }
          }
        },
        "glacier": {
          "description": "the last world:glacier payload (starts at mass 0.5, no tongues, no ash).",
          "type": "object", "required": ["mass", "tongues", "ash"], "additionalProperties": false,
          "properties": {
            "mass": { "type": "number", "minimum": 0, "maximum": 1 },
            "tongues": { "type": "array", "items": { "type": "object", "required": ["app", "len"], "additionalProperties": false, "properties": { "app": { "$ref": "world.json#/$defs/app" }, "len": { "type": "number" } } } },
            "ash": { "type": "array", "maxItems": 32, "items": { "$ref": "world.json#/$defs/day" } }
          }
        },
        "ash": {
          "description": "world:ash payloads, newest day first, one per day + title.",
          "type": "array", "maxItems": 32,
          "items": { "type": "object", "required": ["day"], "additionalProperties": false, "properties": { "day": { "$ref": "world.json#/$defs/day" }, "title": { "type": "string", "maxLength": 120 } } }
        },
        "health": { "description": "app -> ArgoCD health", "type": "object", "propertyNames": { "$ref": "world.json#/$defs/app" }, "additionalProperties": { "enum": ["Healthy", "Progressing", "Degraded", "Suspended", "Missing", "Unknown"] } },
        "replicas": { "description": "app -> replica bucket", "type": "object", "propertyNames": { "$ref": "world.json#/$defs/app" }, "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 8 } },
        "builds": { "description": "app -> build in flight (ev build queued|running; success|failure removes it)", "type": "object", "propertyNames": { "$ref": "world.json#/$defs/app" }, "additionalProperties": { "enum": ["queued", "running"] } },
        "marks": {
          "description": "W4: the active visitor marks, world:mark payloads (never gone), oldest first; a new one beyond 2000 drops the oldest, gone removes its id.",
          "type": "array", "maxItems": 2000,
          "items": {
            "type": "object", "required": ["id", "mark", "pose", "weight"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "mark": { "type": "string", "pattern": "^[a-z-]{1,24}$" },
              "pose": { "$ref": "#/$defs/pose" },
              "weight": { "type": "number" },
              "by": { "type": "string", "pattern": "^[a-z0-9_-]{3,20}$" }
            }
          }
        },
        "clouds": {
          "description": "W4: the live toy clouds, world:cloud payloads, one per id (a frame replaces its id; state gone removes it), ≤ 256.",
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "required": ["id", "pos", "state", "credits"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "pos": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "state": { "enum": ["drift", "rain"] },
              "credits": { "type": "array", "maxItems": 16, "items": { "$ref": "world.json#/$defs/handle" } }
            }
          }
        }
      }
    },
    "metrics": { "$ref": "metrics.json" }
  },
  "$defs": {
    "pose": { "type": "object", "maxProperties": 16, "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]{0,15}$" }, "additionalProperties": { "oneOf": [{ "type": "number" }, { "type": "boolean" }, { "type": "array", "items": { "type": "number" }, "maxItems": 16 }] } },
    "grid16": { "type": "string", "pattern": "^[A-Za-z0-9+/]+=*$", "minLength": 43692, "maxLength": 43692 }
  }
}
