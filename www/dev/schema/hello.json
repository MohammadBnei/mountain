{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hello.json",
  "title": "hello frame (server -> client, on connect and on resync)",
  "description": "R7 town: snapshot = the day the state and deltas start from and the world's generation (epoch 2 = the town); town = the static geometry; state + deltas = the live town. Generated by `relay dump-hello`, never by hand.",
  "type": "object",
  "required": ["t", "snapshot", "deltas", "state", "metrics", "town"],
  "additionalProperties": false,
  "properties": {
    "t": { "const": "hello" },
    "snapshot": {
      "type": "object", "required": ["day", "epoch"], "additionalProperties": false,
      "properties": {
        "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "epoch": { "const": 2 }
      }
    },
    "deltas": { "type": "array", "items": { "type": "object", "required": ["t"], "properties": { "t": { "enum": ["ev", "world"] } } } },
    "state": {
      "description": "Live state a reload must not lose, persisted with the snapshot: firing alerts, health, replicas, builds in flight, visitor marks, the town's plots. It changes only through frames (relay State.apply, mirrored by world.js).",
      "type": "object", "required": ["alerts", "health", "replicas", "builds", "marks", "plots"], "additionalProperties": false,
      "properties": {
        "alerts": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "required": ["fp", "sev", "layer", "startsAt"], "additionalProperties": false,
            "properties": {
              "fp": { "$ref": "ev.json#/$defs/fp" },
              "sev": { "$ref": "ev.json#/$defs/sev" },
              "layer": { "$ref": "ev.json#/$defs/layer" },
              "startsAt": { "type": "integer", "minimum": 0 },
              "host": { "$ref": "ev.json#/$defs/host" },
              "app": { "$ref": "ev.json#/$defs/app" }
            }
          }
        },
        "health": { "description": "app -> ArgoCD health", "type": "object", "propertyNames": { "$ref": "world.json#/$defs/app" }, "additionalProperties": { "enum": ["Healthy", "Progressing", "Degraded", "Suspended", "Missing", "Unknown"] } },
        "replicas": { "description": "app -> replica bucket", "type": "object", "propertyNames": { "$ref": "world.json#/$defs/app" }, "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 8 } },
        "builds": { "description": "app -> build in flight (ev build queued|running; success|failure removes it)", "type": "object", "propertyNames": { "$ref": "world.json#/$defs/app" }, "additionalProperties": { "enum": ["queued", "running"] } },
        "marks": {
          "description": "W4: the active visitor marks, world:mark payloads (never gone), oldest first; a new one beyond 2000 drops the oldest, gone removes its id.",
          "type": "array", "maxItems": 2000,
          "items": {
            "type": "object", "required": ["id", "mark", "pose", "weight"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "mark": { "type": "string", "pattern": "^[a-z-]{1,24}$" },
              "pose": { "$ref": "#/$defs/pose" },
              "weight": { "type": "number" },
              "by": { "type": "string", "pattern": "^[a-z0-9_-]{3,20}$" }
            }
          }
        },
        "plots": {
          "description": "R7: the town buildings, world:plot payloads, one per app (a frame replaces it; gone removes it), ≤ 64.",
          "type": "array", "maxItems": 64, "items": { "$ref": "world.json#/$defs/plot" }
        }
      }
    },
    "metrics": { "$ref": "metrics.json" },
    "town": {
      "description": "R7: the static town geometry (relay/town): islands h1..h3 (global axial centre q, r; tiles = one kind per local hex in canonical order: r ascending, then q; s square, g grass, r road, b bridge head, m meadow) and the bridges between their heads.",
      "type": "object", "required": ["radius", "islands", "bridges"], "additionalProperties": false,
      "properties": {
        "radius": { "const": 4 },
        "islands": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "required": ["host", "q", "r", "tiles"], "additionalProperties": false,
            "properties": {
              "host": { "$ref": "world.json#/$defs/host" },
              "q": { "type": "integer" }, "r": { "type": "integer" },
              "tiles": { "type": "string", "pattern": "^[sgrbm]{61}$" }
            }
          }
        },
        "bridges": {
          "type": "array", "maxItems": 3,
          "items": {
            "type": "object", "required": ["a", "b", "aq", "ar", "bq", "br"], "additionalProperties": false,
            "properties": {
              "a": { "$ref": "world.json#/$defs/host" }, "b": { "$ref": "world.json#/$defs/host" },
              "aq": { "$ref": "world.json#/$defs/hexc" }, "ar": { "$ref": "world.json#/$defs/hexc" },
              "bq": { "$ref": "world.json#/$defs/hexc" }, "br": { "$ref": "world.json#/$defs/hexc" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pose": { "type": "object", "maxProperties": 16, "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]{0,15}$" }, "additionalProperties": { "oneOf": [{ "type": "number" }, { "type": "boolean" }, { "type": "array", "items": { "type": "number" }, "maxItems": 16 }] } }
  }
}
